# Selection background color
selection-background = 7aa2f7

# Window settings
macos-titlebar-style = hidden
window-padding-x = 0
window-padding-y = 0
background-opacity = 0.95
background-blur-radius = 20

# Keyboard settings for tmux
macos-option-as-alt = true
keybind = alt+left=text:\x1b[1;3D
keybind = alt+right=text:\x1b[1;3C
keybind = alt+1=text:\x1b1
keybind = alt+2=text:\x1b2
keybind = alt+3=text:\x1b3
keybind = alt+4=text:\x1b4
