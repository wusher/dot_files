# Shell command
# command = /opt/homebrew/bin/zellij

# Font settings
font-family = JetBrains Mono Nerd Font
font-size = 13

# Color palette
foreground = a9b1d6
background = 1a1b26
palette = 0=32344a
palette = 1=f7768e
palette = 2=9ece6a
palette = 3=e0af68
palette = 4=7aa2f7
palette = 5=ad8ee6
palette = 6=449dab
palette = 7=787c99
palette = 8=444b6a
palette = 9=ff7a93
palette = 10=b9f27c
palette = 11=ff9e64
palette = 12=7da6ff
palette = 13=bb9af7
